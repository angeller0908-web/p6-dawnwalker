---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSlot from "../../components/AdSlot.astro";
import { GAME } from "../../consts";

const tools = [
  {
    href: "/tools/which-dawnwalker-are-you/",
    title: "Which Dawnwalker Are You?",
    desc: "A quick personality quiz that matches your instincts to a Dawnwalker playstyle — predator, penitent, schemer, or wanderer.",
    glyph: "☾",
    tag: "Quiz",
    live: true,
  },
  {
    href: "/tools/editions-comparison/",
    title: "Editions Comparison",
    desc: "Compare the Standard, Eclipse, Day One, and Collector's editions side by side, filter by what you care about, and see which is worth it.",
    glyph: "⚖",
    tag: "Buyer's tool",
    live: true,
  },
  {
    href: "/tools/build-planner/",
    title: "Build & Skill Planner",
    desc: "Plan your hex magic, vampire powers, and combat skills. The interactive planner unlocks the moment the skill trees are revealed at launch.",
    glyph: "⚔",
    tag: "Launches Sep 3",
    live: false,
  },
];
---

<BaseLayout
  title="Interactive Tools"
  description={`Interactive ${GAME.title} tools — a playstyle quiz, an editions comparison, and a build planner launching on release day.`}
>
  <Breadcrumbs items={[{ name: "Home", url: "/" }, { name: "Tools", url: "/tools/" }]} />

  <header class="mb-8">
    <h1 class="font-[var(--font-display)] text-3xl sm:text-4xl font-bold mb-2">
      Tools
    </h1>
    <p class="text-[var(--color-muted)] text-lg">
      Interactive companions for {GAME.title} — find your playstyle, pick the
      right edition, and plan your build.
    </p>
  </header>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((t) => (
      <a
        href={t.href}
        class="card-glow spotlight reveal group relative flex flex-col rounded-lg border border-[var(--color-ink-3)] bg-[var(--color-ink-2)]/90 p-6"
      >
        <div class="mb-4 flex items-center justify-between">
          <span class="font-[var(--font-display)] text-4xl text-[var(--color-blood-bright)] opacity-80">{t.glyph}</span>
          <span class:list={[
            "rounded px-2 py-0.5 text-[10px] uppercase tracking-wide",
            t.live ? "bg-[var(--color-blood)]/20 text-[var(--color-dawn)]" : "bg-[var(--color-ink-3)] text-[var(--color-muted)]",
          ]}>{t.tag}</span>
        </div>
        <h2 class="font-[var(--font-display)] text-lg text-[var(--color-parchment)] group-hover:text-[var(--color-dawn)] transition-colors mb-1">
          {t.title}
        </h2>
        <p class="text-sm text-[var(--color-muted)]">{t.desc}</p>
        <span class="mt-4 text-sm text-[var(--color-dawn)]">
          {t.live ? "Open tool →" : "Preview →"}
        </span>
      </a>
    ))}
  </div>

  <div class="mt-10">
    <AdSlot />
  </div>
</BaseLayout>
