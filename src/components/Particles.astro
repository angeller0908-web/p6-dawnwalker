---
// Floating light effect: drifting ambient glow orbs + rising embers.
// Pure CSS animations (GPU transforms/opacity only), no JS, no layout cost.
// Deterministic pseudo-random so the build output is stable.

// Tiny seeded RNG (mulberry32) — keeps positions stable across builds.
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(20260903);
const pick = <T,>(arr: T[]) => arr[Math.floor(rand() * arr.length)];

const emberColors = ["#e8a33d", "#e23645", "#f0c27a", "#b21f2c"];
const EMBER_COUNT = 42;

const embers = Array.from({ length: EMBER_COUNT }, () => {
  const size = 2.5 + rand() * 5; // 2.5–7.5px
  const dur = 13 + rand() * 16; // 13–29s
  return {
    left: (rand() * 100).toFixed(2),
    size: size.toFixed(2),
    color: pick(emberColors),
    dur: dur.toFixed(1),
    delay: (-rand() * dur).toFixed(1), // negative → already in motion at load
    sway: (rand() * 70 - 35).toFixed(0), // -35–35px horizontal drift
    maxOp: (0.55 + rand() * 0.4).toFixed(2), // 0.55–0.95
  };
});

const orbs = [
  { c: "rgba(178,31,44,0.5)", size: 460, top: "-8%", left: "8%", dx: "60px", dy: "40px", dur: "38s" },
  { c: "rgba(232,163,61,0.4)", size: 380, top: "30%", left: "72%", dx: "-50px", dy: "-30px", dur: "31s" },
  { c: "rgba(120,60,140,0.4)", size: 420, top: "68%", left: "20%", dx: "40px", dy: "-50px", dur: "44s" },
];
---

<div class="fx-layer" aria-hidden="true">
  {orbs.map((o) => (
    <div
      class="fx-orb"
      style={`width:${o.size}px;height:${o.size}px;top:${o.top};left:${o.left};background:radial-gradient(circle,${o.c},transparent 70%);--dx:${o.dx};--dy:${o.dy};--dur:${o.dur}`}
    />
  ))}
  {embers.map((e) => (
    <span
      class="fx-ember"
      style={`left:${e.left}%;width:${e.size}px;height:${e.size}px;--c:${e.color};--dur:${e.dur}s;animation-delay:${e.delay}s;--sway:${e.sway}px;--max-op:${e.maxOp}`}
    />
  ))}
</div>
