---
import { SITE, NAV } from "../consts";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="border-b border-[var(--color-ink-3)] bg-[var(--color-ink-2)]/80 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto max-w-5xl px-4 h-16 flex items-center justify-between">
    <a href="/" class="font-[var(--font-display)] text-lg font-bold tracking-wide text-[var(--color-parchment)]">
      <span class="text-[var(--color-blood-bright)]">⊹</span> {SITE.name}
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <nav aria-label="Main navigation">
        <ul class="flex items-center gap-1 sm:gap-2 text-sm">
          {NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class={`px-3 py-2 rounded transition-colors ${
                  isActive(item.href)
                    ? "text-[var(--color-dawn)] font-semibold"
                    : "text-[var(--color-muted)] hover:text-[var(--color-parchment)]"
                }`}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle"
        title="Toggle day / night"
        aria-label="Toggle day or night theme"
      >
        {/* Shown in night mode → click for day (sun) */}
        <svg class="icon-night" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
        {/* Shown in day mode → click for night (moon) */}
        <svg class="icon-day" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </div>
  </div>
</header>
